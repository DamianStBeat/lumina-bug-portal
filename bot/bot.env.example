# Copy to ~/.config/lumina-bug-portal/bot.env and set mode 600 (chmod 600). Never commit the real file.
# Values below are placeholders.
DISCORD_TOKEN=replace-with-the-bot-token
DISCORD_APP_ID=replace-with-the-application-id
DISCORD_GUILD_ID=1440485385112125563
BUG_FORUM_CHANNEL_ID=1561007238103961620
# The worker API base including /api/v1, no trailing slash.
PORTAL_API_BASE=https://example.invalid/api/v1
AGENT_KEY=replace-with-the-agent-key
SITE_BASE=https://example.invalid
# Optional: where the event cursor is kept (default ~/.local/state/lumina-bug-bot).
# LUMINA_BOT_STATE_DIR=
# Optional, one start only: with no cursor file, post every past event instead of skipping the history.
# LUMINA_BOT_REPLAY=1
