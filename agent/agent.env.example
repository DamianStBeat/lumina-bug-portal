# Copy to ~/.config/lumina-bug-portal/agent.env and `chmod 600` it. Never commit the real file.
# Process environment variables override these values.
PORTAL_API_BASE=http://127.0.0.1:8787/api/v1
AGENT_KEY=replace-with-the-worker-agent-key
LUMINA2_REPO=/home/damian/Developer/GitHub/Lumina2Workspace/Lumina2
DAILY_TRIAGE_CAP=40
DAILY_FIX_CAP=5
POLL_SECONDS=120
# 1 = dry run (the default): only GET requests, no claude, no worktree, no PR; logs what it would do.
DRY_RUN=1
# Optional, with their defaults:
# STATE_DIR=~/.local/state/lumina-bug-agent
# TMP_ROOT=/tmp
# WORKTREE_ROOT=~/Developer/GitHub/Lumina2Workspace/bug-agent-worktrees
# GIT_WORKSPACE=~/Developer/GitHub/_tools/git-workspace.py
# REDTEAM_SCRIPT=~/.claude/skills/lumina2-pr/redteam_fast.sh
# CLAUDE_BIN=claude
# GH_BIN=gh
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# Font of the time stamps on the video sheets; a missing file uses fontconfig's Sans. No `:`, `,`, `'` or `\` in it.
# FRAME_FONT=/usr/share/fonts/truetype/freefont/FreeSans.ttf
# AGENT_ID=valor1-agent
# LEASE_MINUTES=60
# MAX_REPORTS_PER_ROUND=5
# FORK_REMOTE=fork
# PR_REPO=DamianStBeat/Lumina2
